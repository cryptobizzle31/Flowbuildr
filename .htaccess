# FlowBuildr: Hostinger (LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Build sources, tooling, and handler docs are not part of the public site.
# Also refuse a config file if one is ever placed in the web root by mistake.
RedirectMatch 404 ^/(_src(/.*)?|docs(/.*)?|build\.py|attio-config\.php|attio-config\.example\.php|\.git(/.*)?)$

<IfModule mod_mime.c>
  AddType text/plain .txt
  AddCharset utf-8 .txt .html .css .js .xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
